<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted-glass look to match the app: translucent dark with a soft green tint,
     thin light border, rounded corners. (Widgets can't blur the wallpaper; it shows through.) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#B30A1517"
                android:startColor="#9914332E"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
